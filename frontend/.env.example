# =====================================================================
# Frontend environment — copy to `.env` and fill in real values.
# Vite exposes only variables prefixed with VITE_ to the browser.
# These are SAFE to be public (they are not secrets).
# =====================================================================

# Supabase project (from Dashboard → Project Settings → API)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clerk publishable key (from Dashboard → API Keys). Auth is owned by Clerk.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Base URL of the Node/Express API (no trailing slash). Endpoints live under /api.
VITE_API_URL=http://localhost:5000

# Stripe publishable key — used only if you checkout with Stripe.js directly.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
